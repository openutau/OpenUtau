  <system:String x:Key="tip.aliasbox">Timpa Alias</system:String>
  <system:String x:Key="tip.exps">Numerikal,Jenis Opsi
    Tombol Kiri Gambar: Atur ekspresi
    Shift + Tombol Kiri Gambar: Atur ekspresi sama
    Tombol Kanan Gambar: Atur ulang ekspresi
Jenis Kurva
    Tombol Kiri Gambar: Gambar
    Shift + Ctrl + Tombol Kiri Gambar: Gambar Garis
    Shift + Tombol Kiri Gambar: Gambar Garis Horizontal
    Tombol Kanan Gambar: Atur Ulang Garis</system:String>
  <system:String x:Key="tip.exps.notsupported">Ekspresi tidak didukung oleh renderer</system:String>
  <system:String x:Key="tip.lyricbox.next">Tab: Not Berikutnya</system:String>
  <system:String x:Key="tip.lyricbox.prev">Shift+Tab: Not Sebelumnya</system:String>
  <system:String x:Key="tip.notes.basics">Alat Seleksi
    Kotak Pilih: Pilih not
    Ctrl + Kotak Pilih: Pilih lebih banyak not
    Atas/Bawah: Transpos not yang dipilih
    Ctrl + Atas/Bawah: Transpos nada yang dipilih berdasarkan oktaf
Alat Pena
    Tombol Kiri Tarik: Menambahkan not
    Klik Kanan: Menghapus not
    Tombol Kanan Tarik: Menghapus beberapa not
Umum
    T: Alihkan Tips
    Seret Not: Memindahkan not
    Seret Ujung Not: Mengubah ukuran not
    Alt + Seret Ujung Not: Mengubah ukuran nada yang bersebelahan
    Spasi: Memainkan</system:String>
  <system:String x:Key="tip.notes.zoomx">◀ Gulir ke sini untuk memperbesar secara horizontal ▶</system:String>
