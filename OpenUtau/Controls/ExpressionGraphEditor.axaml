<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:OpenUtau.App.Controls"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Controls.ExpressionGraphEditor"
        KeyDown="OnKeyDown">
  <UserControl.Styles>
    <Style Selector="FlyoutPresenter.graphhelp">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="230,*" RowDefinitions="*,Auto">
    <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="10">
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Name="GraphSettings">
        <TextBlock Text="{DynamicResource expressiongraph.name}"/>
        <TextBox Name="NameBox" LostFocus="OnNameCommitted" KeyDown="OnNameKeyDown"/>
        <TextBlock Name="RendererText"/>
        <TextBlock Text="{DynamicResource expressiongraph.pitchcurve}"/>
        <ComboBox Name="PitchCurveBox" HorizontalAlignment="Stretch" SelectionChanged="OnPitchCurveChanged">
          <ComboBoxItem Content="{DynamicResource expressiongraph.pitchcurve.pitd}"/>
          <ComboBoxItem Content="{DynamicResource expressiongraph.pitchcurve.pito}"/>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <CheckBox Name="DefaultBox" IsCheckedChanged="OnDefaultChanged"/>
          <TextBlock Text="{DynamicResource expressiongraph.default}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
      <!-- Library actions: two rows of equal-width buttons spanning the column. -->
      <UniformGrid DockPanel.Dock="Bottom" Columns="2" ColumnSpacing="4" Margin="0,0,0,6">
        <UniformGrid.Styles>
          <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
          </Style>
        </UniformGrid.Styles>
        <Button Content="{DynamicResource expressiongraph.import}" Click="OnImport"/>
        <Button Content="{DynamicResource expressiongraph.export}" Click="OnExport" Name="ExportButton"/>
      </UniformGrid>
      <UniformGrid DockPanel.Dock="Bottom" Columns="3" ColumnSpacing="4" Margin="0,6,0,4">
        <UniformGrid.Styles>
          <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
          </Style>
        </UniformGrid.Styles>
        <Button Content="{DynamicResource expressiongraph.new}" Click="OnNew" Name="NewButton"/>
        <Button Content="{DynamicResource expressiongraph.duplicate}" Click="OnDuplicate" Name="DuplicateButton"/>
        <Button Content="{DynamicResource expressiongraph.delete}" Click="OnDelete" Name="DeleteButton"/>
      </UniformGrid>
      <ListBox Name="GraphList" SelectionChanged="OnGraphSelected"/>
    </DockPanel>
    <Border Grid.Column="1" Margin="0,10,10,0" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Panel>
        <c:ExpressionGraphCanvas Name="Canvas"/>
        <TextBlock Name="Hint" Text="{DynamicResource expressiongraph.hint}" Margin="10" Opacity="0.6"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Button Classes="clear" Width="24" Height="24" Margin="6" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="{DynamicResource expressiongraph.help}">
          <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource ForegroundBrushSecondary}"
                Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z"/>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="graphhelp">
              <StackPanel Width="380">
                <TextBlock Margin="14,10" FontWeight="SemiBold" Text="{DynamicResource expressiongraph.help}"/>
                <Border Height="1" Background="{DynamicResource MenuFlyoutPresenterBorderBrush}"/>
                <Grid Margin="14,10,14,12" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="6"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <Grid.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                    <Style Selector="TextBlock.gesture">
                      <Setter Property="Grid.Column" Value="1"/>
                      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrushSecondary}"/>
                    </Style>
                  </Grid.Styles>
                  <TextBlock Grid.Row="0" Text="{DynamicResource expressiongraph.help.add}"/>
                  <TextBlock Grid.Row="0" Classes="gesture" Text="{DynamicResource expressiongraph.help.add.gesture}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource expressiongraph.help.link}"/>
                  <TextBlock Grid.Row="1" Classes="gesture" Text="{DynamicResource expressiongraph.help.link.gesture}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource expressiongraph.help.unlink}"/>
                  <TextBlock Grid.Row="2" Classes="gesture" Text="{DynamicResource expressiongraph.help.unlink.gesture}"/>
                  <TextBlock Grid.Row="3" Text="{DynamicResource expressiongraph.help.move}"/>
                  <TextBlock Grid.Row="3" Classes="gesture" Text="{DynamicResource expressiongraph.help.move.gesture}"/>
                  <TextBlock Grid.Row="4" Text="{DynamicResource expressiongraph.help.pan}"/>
                  <TextBlock Grid.Row="4" Classes="gesture" Text="{DynamicResource expressiongraph.help.pan.gesture}"/>
                  <TextBlock Grid.Row="5" Text="{DynamicResource expressiongraph.help.zoom}"/>
                  <TextBlock Grid.Row="5" Classes="gesture" Text="{DynamicResource expressiongraph.help.zoom.gesture}"/>
                  <TextBlock Grid.Row="6" Text="{DynamicResource expressiongraph.help.fit}"/>
                  <TextBlock Grid.Row="6" Classes="gesture" Text="Home"/>
                  <TextBlock Grid.Row="7" Text="{DynamicResource expressiongraph.help.select}"/>
                  <TextBlock Grid.Row="7" Classes="gesture" Text="{DynamicResource expressiongraph.help.select.gesture}"/>
                  <TextBlock Grid.Row="8" Text="{DynamicResource expressiongraph.help.selectall}"/>
                  <TextBlock Grid.Row="8" Classes="gesture" Text="Ctrl+A / Esc"/>
                  <TextBlock Grid.Row="9" Text="{DynamicResource expressiongraph.help.copy}"/>
                  <TextBlock Grid.Row="9" Classes="gesture" Text="Ctrl+C / Ctrl+X / Ctrl+V"/>
                  <TextBlock Grid.Row="10" Text="{DynamicResource expressiongraph.duplicatenodes}"/>
                  <TextBlock Grid.Row="10" Classes="gesture" Text="Ctrl+D"/>
                  <TextBlock Grid.Row="11" Text="{DynamicResource expressiongraph.delete}"/>
                  <TextBlock Grid.Row="11" Classes="gesture" Text="Delete"/>
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Panel>
    </Border>
    <TextBlock Grid.Column="1" Grid.Row="1" Name="Status" Margin="0,4,10,8" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
